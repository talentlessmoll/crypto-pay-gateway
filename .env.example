# ==========================================
# Crypto Payment Gateway Configuration
# ==========================================

# Port the server listens on (Render automatically provides PORT in production)
PORT=3000

# Your receiving EVM wallet address (MetaMask / Trust Wallet address)
# IMPORTANT: Put your personal 0x... address here. Funds go directly to this address.
MERCHANT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Supported Network RPC URLs (Free public RPCs by default)
POLYGON_RPC_URL=https://polygon-rpc.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Standard Contract Addresses (Polygon USDT, BSC USDT)
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Optional webhook URL on your main site to notify when payment succeeds
WEBHOOK_URL=
